  <step>
    <name>Ler partidas</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../data/input/partidas.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>partida_id</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>torneio_id</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>data_partida</name><type>Date</type><format>yyyy-MM-dd</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>ronda</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>vencedor_id</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>vencido_id</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>resultado</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>ranking_vencedor</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>ranking_vencido</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
    </fields>

    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>40</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Remover duplicados</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>N</store_values>
    <fields><field><name>partida_id</name></field></fields>

