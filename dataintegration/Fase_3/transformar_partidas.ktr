      <splitevery>0</splitevery>
    </file>
    <fields>
      <field><name>partida_id</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
      <field><name>resultado</name><type>String</type><format></format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field>
