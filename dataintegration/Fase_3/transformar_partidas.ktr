      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Validar resultado</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <script><![CDATA[^(\d+-\d+(\(\d+\))?(\s\d+-\d+(\(\d+\))?){0,4}|W/O|RET)$]]></script>
    <matcher>resultado</matcher>
    <resultfieldname>resultado_valido</resultfieldname>
    <usevar>N</usevar><allowcapturegroups>Y</allowcapturegroups><replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment>
    <dotall>N</dotall><multiline>N</multiline><unicode>N</unicode><unix>N</unix>
    <fields>
      <field><name>set1</name><type>String</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field>
      <field><name>tb1</name><type>String</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field>
      <field><name>resto_sets</name><type>String</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field>
      <field><name>tb_resto</name><type>String</type><format/><group/><decimal/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype><currency/></field>
    </fields>

    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Resultado valido</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Lookup torneio</send_true_to>
    <send_false_to>Rejeitados</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>resultado_valido</leftvalue><function>=</function><rightvalue/>
      <value><name>constant</name><type>Boolean</type><text>true</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
    </condition></compare>

    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>460</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
